generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                          String                   @id @default(uuid())
  name                                        String
  email                                       String                   @unique
  password                                    String
  failedLoginAttempts                         Int                      @default(0)
  isBlocked                                   Boolean                  @default(false)
  roleId                                      String
  createdAt                                   DateTime                 @default(now())
  updatedAt                                   DateTime                 @updatedAt
  intakeTargets                               CounsellorIntakeTarget[] @relation("UserIntakeTargets")
  createdIntakeTargets                        CounsellorIntakeTarget[] @relation("UserCreatedIntakeTargets")
  leadsConverted                              Lead[]                   @relation("LeadConvertedBy")
  leadsCreated                                Lead[]                   @relation("LeadCreatedBy")
  leadsUpdated                                Lead[]                   @relation("LeadUpdatedBy")
  leadCounselorsAssigned                      LeadCounselor[]          @relation("LeadAssignedBy")
  leadAssignments                             LeadCounselor[]
  leadTimelinesCreated                        LeadTimeline[]           @relation("LeadTimelineCreatedBy")
  leadTimelinesUpdated                        LeadTimeline[]           @relation("LeadTimelineUpdatedBy")
  leadFintechAssignments                      Lead[]                   @relation("LeadFintech")
  loanActivitiesCreated                       LoanActivity[]           @relation("LoanActivityCreatedBy")
  loanApplicationsCounseled                   LoanApplication[]        @relation("LoanApplicationCounselor")
  loanApplicationCreated                      LoanApplication[]        @relation("LoanApplicationCreatedBy")
  loanApplicationsFintech                     LoanApplication[]        @relation("LoanApplicationFintech")
  LoanFollowUp                                LoanFollowUp[]           @relation("LoanFollowUpCreatedBy")
  mbbsLeadsCreated                            MbbsLead[]               @relation("MbbsLeadCreatedBy")
  mbbsLeadsUpdated                            MbbsLead[]               @relation("MbbsLeadUpdatedBy")
  mbbsLeadCounselorsAssigned                  MbbsLeadCounselor[]      @relation("MbbsLeadAssignedBy")
  mbbsLeadAssignments                         MbbsLeadCounselor[]
  mbbsTimelinesCreated                        MbbsLeadTimeline[]       @relation("MbbsTimelineCreatedBy")
  mbbsTimelinesUpdated                        MbbsLeadTimeline[]       @relation("MbbsTimelineUpdatedBy")
  Notification_Notification_actorIdToUser     Notification[]           @relation("Notification_actorIdToUser")
  Notification_Notification_recipientIdToUser Notification[]           @relation("Notification_recipientIdToUser")
  students                                    Student[]                @relation("CounselorStudents")
  fintechAssignedStudentLoans                 StudentLoanProfile[]     @relation("FintechAssignedStudentLoans")
  studentRemarks                              StudentRemark[]          @relation("StudentRemark")
  studentTimelines                            StudentTimeline[]        @relation("StudentTimelineCreatedBy")
  role                                        Role                     @relation(fields: [roleId], references: [id])
  branches                                    Branch[]                 @relation("BranchToUser")
}

model Role {
  id                String                 @id @default(uuid())
  name              String                 @unique
  description       String?
  isSystem          Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  modulePermissions RoleModulePermission[]
  users             User[]
}

model Module {
  id                String                 @id @default(uuid())
  name              String
  code              String                 @unique
  icon              String?
  sortOrder         Int                    @default(0)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  modulePermissions RoleModulePermission[]
}

model RoleModulePermission {
  roleId    String
  moduleId  String
  canCreate Boolean @default(false)
  canRead   Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, moduleId])
}

model CounsellorIntakeTarget {
  id           String   @id @default(uuid())
  intakeId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?
  counsellorId String
  target       Int      @default(0)
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  counsellor   User     @relation("UserIntakeTargets", fields: [counsellorId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation("UserCreatedIntakeTargets", fields: [createdById], references: [id])
  intake       Intake   @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@unique([counsellorId, intakeId, branchId])
  @@index([intakeId])
  @@index([branchId])
  @@index([createdById])
}

model LeadEnglishTest {
  id             String          @id @default(uuid())
  leadId         String
  testType       EnglishTestType
  totalScore     Float?
  listeningScore Float?
  readingScore   Float?
  writingScore   Float?
  speakingScore  Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lead           Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, testType])
  @@index([leadId])
  @@index([testType])
}

model Lead {
  id                      String            @id @default(uuid())
  leadNumber              String            @unique
  leadType                LeadType          @default(study_abroad)
  counsellingDate         DateTime?
  studentName             String?
  fatherName              String?
  mobileNumber            String?           @unique
  emailId                 String?           @unique
  place                   String?
  passport                String?
  passportExpireDate      DateTime?
  source                  String?
  branchId                String
  isConverted             Boolean           @default(false)
  convertedById           String?
  convertedAt             DateTime?
  tenthPercentage         Float?
  tenthYearOfPassing      Int?
  twelfthPercentage       Float?
  twelfthYearOfPassing    Int?
  bachelorsCourse         String?
  bachelorsUniversityName String?
  bachelorsPercentage     Float?
  bachelorsYearOfPassing  Int?
  backlogs                Int?
  workExperience          String?
  preferredCountry        String?
  preferredIntake         String?
  preferredCourse         String?
  preferredTiers          String[]          @default([])
  greGmatScore            Float?
  quantitativeScore       Float?
  verbalScore             Float?
  analyticalWritingScore  Float?
  gapsIfAny               String?
  status                  LeadStatus        @default(NEW)
  graduationStatus        GraduationStatus?
  loanRequirement         Boolean           @default(false)
  nextFollowup            DateTime?
  remarks                 String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  createdById             String?
  updatedById             String?
  branch                  Branch            @relation(fields: [branchId], references: [id])
  convertedBy             User?             @relation("LeadConvertedBy", fields: [convertedById], references: [id])
  createdBy               User?             @relation("LeadCreatedBy", fields: [createdById], references: [id])
  updatedBy               User?             @relation("LeadUpdatedBy", fields: [updatedById], references: [id])
  counselors              LeadCounselor[]
  englishTests            LeadEnglishTest[]
  timelines               LeadTimeline[]
  loanApplication         LoanApplication?
  student                 Student?
  fintechAssigneeId       String?

  fintechAssignee User? @relation("LeadFintech", fields: [fintechAssigneeId], references: [id])

  @@index([branchId])
  @@index([branchId, status])
  @@index([branchId, isConverted])
  @@index([convertedById])
}

model LeadCounselor {
  id           String   @id @default(uuid())
  leadId       String
  counselorId  String
  assignedAt   DateTime @default(now())
  assignedById String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  assignedBy   User?    @relation("LeadAssignedBy", fields: [assignedById], references: [id])
  counselor    User     @relation(fields: [counselorId], references: [id])
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, counselorId])
}

model MbbsLeadCounselor {
  id           String   @id @default(uuid())
  mbbsLeadId   String
  counselorId  String
  assignedAt   DateTime @default(now())
  assignedById String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  assignedBy   User?    @relation("MbbsLeadAssignedBy", fields: [assignedById], references: [id])
  counselor    User     @relation(fields: [counselorId], references: [id])
  mbbsLead     MbbsLead @relation(fields: [mbbsLeadId], references: [id], onDelete: Cascade)

  @@unique([mbbsLeadId, counselorId])
}

model LeadTimeline {
  id           String    @id @default(uuid())
  leadId       String
  description  String
  nextFollowup DateTime?
  createdById  String?
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    User?     @relation("LeadTimelineCreatedBy", fields: [createdById], references: [id])
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  updatedBy    User?     @relation("LeadTimelineUpdatedBy", fields: [updatedById], references: [id])

  @@index([leadId])
}

model MbbsLeadTimeline {
  id           String    @id @default(uuid())
  mbbsLeadId   String
  description  String
  nextFollowup DateTime?
  createdById  String?
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    User?     @relation("MbbsTimelineCreatedBy", fields: [createdById], references: [id])
  mbbsLead     MbbsLead  @relation(fields: [mbbsLeadId], references: [id])
  updatedBy    User?     @relation("MbbsTimelineUpdatedBy", fields: [updatedById], references: [id])

  @@index([mbbsLeadId])
}

model MbbsLead {
  id                  String              @id @default(uuid())
  leadNumber          String              @unique
  counsellingDate     DateTime?
  studentName         String?
  fatherName          String?
  mobileNumber        String?             @unique
  emailId             String?             @unique
  address             String?
  state               String?
  city                String?
  passport            String?
  passportExpireDate  DateTime?
  source              String?
  branchId            String
  twelfthCollegeName  String?
  twelfthMarks        Float?
  neetMarks           Float?
  ept                 String?
  listeningScore      Float?
  readingScore        Float?
  writingScore        Float?
  speakingScore       Float?
  preferredCountry    String?
  preferredIntake     String?
  preferredUniversity String?
  preferredCourse     String?
  preferredTiers      String[]            @default([])
  remarks             String?
  status              MbbsLeadStatus      @default(NEW)
  nextFollowup        DateTime?
  createdById         String?
  updatedById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  branch              Branch              @relation(fields: [branchId], references: [id])
  createdBy           User?               @relation("MbbsLeadCreatedBy", fields: [createdById], references: [id])
  updatedBy           User?               @relation("MbbsLeadUpdatedBy", fields: [updatedById], references: [id])
  counselors          MbbsLeadCounselor[]
  timelines           MbbsLeadTimeline[]
}

model Student {
  id              String                  @id @default(uuid())
  leadId          String                  @unique
  branchId        String
  counselorId     String?
  studentName     String
  mobileNumber    String                  @unique
  emailId         String                  @unique
  password        String?
  undergraduate   Undergraduate?
  moi             String?
  dob             DateTime?
  gender          GenderType?
  applicationDate DateTime?
  currentStage    StudentStage?
  status          StudentStatus           @default(active)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  branch          Branch                  @relation(fields: [branchId], references: [id])
  counselor       User?                   @relation("CounselorStudents", fields: [counselorId], references: [id])
  lead            Lead                    @relation(fields: [leadId], references: [id])
  applications    StudentApplication[]
  documents       StudentDocument[]
  loanProfile     StudentLoanProfile?
  moduleProgress  StudentModuleProgress[]
  remarks         StudentRemark[]
  timeline        StudentTimeline[]
  visaProfile     StudentVisaProfile?
  documentMasters StudentDocumentMaster[]

  @@index([branchId])
  @@index([counselorId])
}

model StudentDocument {
  id               String   @id @default(uuid())
  studentId        String
  documentCode     String
  documentType     String
  originalFileName String
  storedFileName   String
  fileUrl          String
  mimeType         String
  fileSize         Int
  remarks          String?
  uploadedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  documentMasterId String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  documentMaster StudentDocumentMaster? @relation(fields: [documentMasterId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([studentId, documentCode])
  @@index([documentMasterId])
}

model StudentDocumentMaster {
  id        String   @id @default(uuid())
  studentId String
  code      String
  name      String
  required  Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documents StudentDocument[]

  @@unique([studentId, code])
  @@unique([studentId, name])
  @@index([studentId])
  @@index([studentId, isActive])
  @@index([studentId, sortOrder])
}

model StudentApplication {
  id              String            @id @default(uuid())
  studentId       String
  countryId       String?
  universityId    String
  courseId        String
  intakeId        String?
  portal          String?
  applicationDate DateTime?
  followUpDate    DateTime?
  status          ApplicationStatus @default(on_hold)
  offerStatus     OfferStatus       @default(PENDING)
  countryName     String?
  universityName  String?
  courseName      String?
  intakeName      String?
  remarks         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  country         Country?          @relation(fields: [countryId], references: [id])
  course          UniversityCourse  @relation(fields: [courseId], references: [id])
  intake          Intake?           @relation(fields: [intakeId], references: [id])
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  university      University        @relation(fields: [universityId], references: [id])

  @@index([studentId])
  @@index([countryId])
  @@index([universityId])
  @@index([courseId])
  @@index([intakeId])
}

model StudentVisaProfile {
  id                  String          @id @default(uuid())
  studentId           String          @unique
  depositDeadlineDate DateTime?
  depositStatus       DepositStatus   @default(PENDING)
  ihsPaidStatus       IhsPaidStatus   @default(PENDING)
  visaPaidStatus      String?
  casDeadlineDate     DateTime?
  casStatus           CasStatus       @default(PENDING)
  visaStatus          VisaStatus      @default(DECISION_PENDING)
  universityStartDate DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  visaDecisionDate    DateTime?
  interviewStatus     InterviewStatus @default(NO_INTERVIEW)
  universityEndDate   DateTime?
  student             Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([depositStatus])
  @@index([casStatus])
  @@index([visaStatus])
  @@index([visaDecisionDate])
}

model StudentLoanProfile {
  id                String    @id @default(uuid())
  studentId         String    @unique
  fintechAssigneeId String?
  nbfc              String?
  loanStatus        String?
  pfStatus          String?
  depositDate       DateTime?
  disbursed         Boolean   @default(false)
  disbursedDate     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  fintechAssignee   User?     @relation("FintechAssignedStudentLoans", fields: [fintechAssigneeId], references: [id])
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([loanStatus])
  @@index([fintechAssigneeId])
}

model StudentRemark {
  id          String   @id @default(uuid())
  studentId   String
  note        String
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("StudentRemark", fields: [createdById], references: [id])
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model StudentModuleProgress {
  id        String              @id @default(uuid())
  studentId String
  module    StudentModuleType
  status    StudentModuleStatus @default(not_started)
  progress  Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  student   Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, module])
  @@index([studentId])
  @@index([status])
}

model Branch {
  id                      String                   @id @default(uuid())
  name                    String                   @unique
  code                    String                   @unique
  email                   String?
  phone                   String?
  city                    String?
  state                   String?
  country                 String?
  pincode                 String?
  address                 String?
  status                  Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  counsellorIntakeTargets CounsellorIntakeTarget[]
  leads                   Lead[]
  loanApplications        LoanApplication[]
  mbbsLeads               MbbsLead[]
  Notification            Notification[]
  students                Student[]
  users                   User[]                   @relation("BranchToUser")
}

model StudentTimeline {
  id           String       @id @default(uuid())
  studentId    String
  type         TimelineType
  description  String?
  followupDate DateTime?
  createdById  String?
  createdAt    DateTime     @default(now())
  createdBy    User?        @relation("StudentTimelineCreatedBy", fields: [createdById], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([studentId, createdAt])
}

model Country {
  id                  String               @id @default(uuid())
  name                String               @unique
  code                String               @unique
  currency            String?
  status              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  studentApplications StudentApplication[]
  universities        University[]
}

model Intake {
  id                  String                   @id @default(uuid())
  name                String                   @unique
  status              Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  counsellorTargets   CounsellorIntakeTarget[]
  studentApplications StudentApplication[]
  courses             UniversityCourse[]
}

model LeadSource {
  id        String   @id @default(uuid())
  name      String   @unique
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeadDegree {
  id        String   @id @default(uuid())
  name      String   @unique
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeadUniversity {
  id        String   @id @default(uuid())
  name      String   @unique
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bank {
  id               String                @id @default(uuid())
  name             String                @unique
  status           Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  loanApplications LoanBankApplication[]
  sanctionedLoans  LoanApplication[]     @relation("LoanSanctionBank")

  depositLoans   LoanApplication[] @relation("LoanDepositBank")
  disbursedLoans LoanApplication[] @relation("LoanDisbursedBank")

  @@index([status])
  @@index([name])
}

model University {
  id                  String                  @id @default(uuid())
  name                String
  countryId           String
  tier                UniversityTier          @default(T4)
  logo                String?
  website             String?
  address             String?
  city                String?
  state               String?
  postalCode          String?
  ranking             Int?
  establishedYear     Int?
  applicationFee      Decimal?                @db.Decimal(12, 2)
  currency            String?
  description         String?
  status              UniversityStatus        @default(active)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  contactPerson       String?
  contactEmail        String?
  contactPhone        String?
  intakeNotes         String?
  studentApplications StudentApplication[]
  country             Country                 @relation(fields: [countryId], references: [id])
  courses             UniversityCourse[]
  scholarships        UniversityScholarship[]

  @@unique([name, countryId])
  @@index([countryId])
  @@index([countryId, city])
  @@index([name])
  @@index([city])
  @@index([status])
}

model UniversityCourse {
  id                  String                  @id @default(uuid())
  universityId        String
  name                String
  degree              DegreeType?
  durationMonths      Int?
  annualTuitionFee    Decimal?                @db.Decimal(12, 2)
  totalTuitionFee     Decimal?                @db.Decimal(12, 2)
  currency            String?
  intakeId            String?
  minimumPercentage   Float?
  backlogLimit        Int?
  englishRequirement  String?
  ieltsOverall        Float?
  ieltsListening      Float?
  ieltsReading        Float?
  ieltsWriting        Float?
  ieltsSpeaking       Float?
  greRequired         Boolean                 @default(false)
  gmatRequired        Boolean                 @default(false)
  courseCode          String?
  description         String?
  applicationDeadline DateTime?
  status              Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  studentApplications StudentApplication[]
  intake              Intake?                 @relation(fields: [intakeId], references: [id])
  university          University              @relation(fields: [universityId], references: [id], onDelete: Cascade)
  scholarships        UniversityScholarship[]

  @@index([universityId])
}

model UniversityScholarship {
  id           String            @id @default(uuid())
  universityId String
  name         String
  amount       Decimal?          @db.Decimal(12, 2)
  percentage   Float?
  description  String?
  status       UniversityStatus  @default(active)
  courseId     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  course       UniversityCourse? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  university   University        @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([courseId])
}

model LoanApplication {
  id                       String    @id @default(uuid())
  applicationId            String    @unique
  fullName                 String
  mobile                   String
  altMobile                String?
  email                    String
  dob                      DateTime?
  gender                   String?
  maritalStatus            String?
  aadhaar                  String?
  pan                      String?
  passport                 String?
  passportExpireDate       DateTime?
  currentAddress           String?
  permanentAddress         String?
  city                     String?
  state                    String?
  pin                      String?
  enquiryDate              DateTime?
  leadSource               String?
  branchId                 String
  counselorId              String?
  fintechAssigneeId        String?
  priority                 String?
  nextFollowUp             DateTime?
  remarks                  String?
  applicantCategory        String
  loanCategory             String
  loanStatus               String    @default("New Enquiry")
  qualification            String?
  graduationStatus         String?
  percentage               String?
  yearOfPassing            String?
  currentInstitution       String?
  workExperience           String?
  company                  String?
  designation              String?
  employmentType           String?
  employeeId               String?
  totalExperience          String?
  currentCompanyExperience String?
  monthlySalary            Decimal?  @db.Decimal(12, 2)
  annualIncome             Decimal?  @db.Decimal(12, 2)
  existingEmi              Decimal?  @db.Decimal(12, 2)
  employerAddress          String?
  businessName             String?
  businessType             String?
  registrationType         String?
  registrationNumber       String?
  yearsInBusiness          String?
  annualTurnover           Decimal?  @db.Decimal(12, 2)
  businessAddress          String?
  studyDestination         String?
  country                  String?
  university               String?
  courseName               String?
  courseLevel              String?
  courseDuration           String?
  intake                   String?
  admissionStatus          String?
  offerLetterReceived      String?
  tuitionFee               Decimal?  @db.Decimal(12, 2)
  livingExpenses           Decimal?  @db.Decimal(12, 2)
  otherExpenses            Decimal?  @db.Decimal(12, 2)
  totalCourseCost          Decimal?  @db.Decimal(12, 2)
  ownContribution          Decimal?  @db.Decimal(12, 2)
  requiredLoanAmount       Decimal?  @db.Decimal(12, 2)
  loanPreference           String?
  collateralAvailable      String?
  loanPurpose              String?
  preferredTenure          Int?
  cibilScore               Int?
  propertyType             String?
  propertyLocation         String?
  propertyValue            Decimal?  @db.Decimal(12, 2)
  downPayment              Decimal?  @db.Decimal(12, 2)
  sanctionedAmount         Decimal?  @db.Decimal(12, 2)
  disbursedAmount          Decimal?  @db.Decimal(12, 2)
  depositAmount            Decimal?  @db.Decimal(12, 2)
  depositDate              DateTime?
  depositReference         String?
  depositBankId            String?
  disbursedBankId          String?
  depositBank              Bank?     @relation("LoanDepositBank", fields: [depositBankId], references: [id])
  sanctionBank             Bank?     @relation("LoanSanctionBank", fields: [sanctionBankId], references: [id])
  disbursedBank            Bank?     @relation("LoanDisbursedBank", fields: [disbursedBankId], references: [id])
  depositRemarks           String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  leadId                   String?   @unique
  depositStatus            String?   @default("Pending")
  createdById              String?

  sanctionBankId String?
  sanctionDate   DateTime?

  disbursementStatus String?
  disbursementDate   DateTime?

  activities       LoanActivity[]
  branch           Branch                @relation(fields: [branchId], references: [id])
  counselor        User?                 @relation("LoanApplicationCounselor", fields: [counselorId], references: [id])
  createdBy        User?                 @relation("LoanApplicationCreatedBy", fields: [createdById], references: [id])
  fintechAssignee  User?                 @relation("LoanApplicationFintech", fields: [fintechAssigneeId], references: [id])
  lead             Lead?                 @relation(fields: [leadId], references: [id])
  bankApplications LoanBankApplication[]
  coApplicants     LoanCoApplicant[]
  documents        LoanDocument[]
  followUps        LoanFollowUp[]
  documentMasters  LoanDocumentMaster[]  @relation("LoanApplicationDocumentMasters")

  @@index([branchId])
  @@index([counselorId])
  @@index([fintechAssigneeId])
  @@index([loanStatus])
  @@index([loanCategory])
  @@index([sanctionBankId])
  @@index([depositBankId])
  @@index([disbursedBankId])
}

model LoanBankApplication {
  id              String          @id @default(uuid())
  applicationId   String
  branch          String?
  applicationNo   String?
  appliedAmount   Decimal?        @db.Decimal(12, 2)
  roi             Decimal?        @db.Decimal(5, 2)
  tenure          Int?
  status          String?
  remarks         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  applicationDate DateTime?
  bankId          String
  insuranceAmount Decimal?        @db.Decimal(12, 2)
  loanType        String?
  loginExecutive  String?
  moratorium      String?
  processingFee   Decimal?        @db.Decimal(12, 2)
  rejectionReason String?
  application     LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  bank            Bank            @relation(fields: [bankId], references: [id])

  @@index([applicationId])
  @@index([bankId])
  @@index([status])
}

model LoanCoApplicant {
  id             String          @id @default(uuid())
  applicationId  String
  name           String
  relationship   String?
  mobile         String?
  email          String?
  occupation     String?
  cibilScore     Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  aadhaar        String?
  address        String?
  altMobile      String?
  annualIncome   Decimal?        @db.Decimal(15, 2)
  city           String?
  designation    String?
  dob            DateTime?
  employerName   String?
  employmentType String?
  existingEmi    Decimal?        @db.Decimal(15, 2)
  gender         String?
  monthlyIncome  Decimal?        @db.Decimal(15, 2)
  pan            String?
  pin            String?
  state          String?
  income         Decimal?        @db.Decimal(15, 2)
  application    LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model LoanFollowUp {
  id            String          @id @default(uuid())
  applicationId String
  type          String?
  note          String
  followUpDate  DateTime?
  nextFollowUp  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdById   String?
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy     User?           @relation("LoanFollowUpCreatedBy", fields: [createdById], references: [id])

  @@index([applicationId])
  @@index([nextFollowUp])
}

model LoanActivity {
  id            String          @id @default(uuid())
  applicationId String
  type          String?
  title         String
  description   String?
  createdAt     DateTime        @default(now())
  createdById   String?
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy     User?           @relation("LoanActivityCreatedBy", fields: [createdById], references: [id])

  @@index([applicationId])
  @@index([createdById])
}

enum LoanDocumentCategory {
  KYC
  OPTIONAL
  OTHER
}

model LoanDocument {
  id               String   @id @default(uuid())
  applicationId    String
  documentCode     String
  documentType     String
  originalFileName String
  storedFileName   String
  fileUrl          String
  mimeType         String
  fileSize         Int
  remarks          String?
  uploadedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  documentMasterId String?

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  documentMaster LoanDocumentMaster? @relation(fields: [documentMasterId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([applicationId, documentCode])
  @@index([documentMasterId])
}

model LoanDocumentMaster {
  id            String               @id
  code          String               @unique
  name          String
  category      LoanDocumentCategory
  required      Boolean              @default(false)
  isSystem      Boolean              @default(false)
  isActive      Boolean              @default(true)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime
  applicationId String?
  application   LoanApplication?     @relation("LoanApplicationDocumentMasters", fields: [applicationId], references: [id], onDelete: Cascade)
  LoanDocument  LoanDocument[]

  @@index([category])
  @@index([category, sortOrder])
  @@index([isActive])
  @@index([applicationId])
  @@index([applicationId, category])
}

model Notification {
  id                                  String               @id
  eventId                             String
  eventKey                            String
  recipientId                         String
  actorId                             String?
  branchId                            String?
  entityType                          String?
  entityId                            String?
  title                               String
  message                             String
  actionUrl                           String?
  icon                                String?
  priority                            NotificationPriority @default(NORMAL)
  metadata                            Json?
  readAt                              DateTime?
  archivedAt                          DateTime?
  createdAt                           DateTime             @default(now())
  updatedAt                           DateTime
  User_Notification_actorIdToUser     User?                @relation("Notification_actorIdToUser", fields: [actorId], references: [id])
  Branch                              Branch?              @relation(fields: [branchId], references: [id])
  User_Notification_recipientIdToUser User                 @relation("Notification_recipientIdToUser", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([eventId, recipientId])
  @@index([actorId])
  @@index([branchId])
  @@index([entityType, entityId])
  @@index([eventKey, createdAt])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
}

model NotificationOutbox {
  id            String                   @id
  eventKey      String
  eventVersion  Int                      @default(1)
  aggregateType String
  aggregateId   String
  actorId       String?
  branchId      String?
  payload       Json
  dedupeKey     String                   @unique
  status        NotificationOutboxStatus @default(PENDING)
  attempts      Int                      @default(0)
  nextAttemptAt DateTime                 @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime

  @@index([actorId])
  @@index([aggregateType, aggregateId])
  @@index([branchId])
  @@index([eventKey, createdAt])
  @@index([lockedAt])
  @@index([status, nextAttemptAt, createdAt])
}

