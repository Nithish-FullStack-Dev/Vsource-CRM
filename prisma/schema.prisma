// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  name     String
  email    String @unique
  password String

  branches Branch[]

  leadAssignments        LeadCounselor[]
  leadCounselorsAssigned LeadCounselor[] @relation("LeadAssignedBy")
  leadsConverted         Lead[]          @relation("LeadConvertedBy")

  mbbsLeadAssignments        MbbsLeadCounselor[]
  mbbsLeadCounselorsAssigned MbbsLeadCounselor[] @relation("MbbsLeadAssignedBy")

  students Student[] @relation("CounselorStudents")

  studentTimelines StudentTimeline[] @relation("StudentTimelineCreatedBy")

  studentRemarks StudentRemark[] @relation("StudentRemark")

  leadTimelinesCreated LeadTimeline[] @relation("LeadTimelineCreatedBy")
  leadTimelinesUpdated LeadTimeline[] @relation("LeadTimelineUpdatedBy")

  mbbsTimelinesCreated MbbsLeadTimeline[] @relation("MbbsTimelineCreatedBy")
  mbbsTimelinesUpdated MbbsLeadTimeline[] @relation("MbbsTimelineUpdatedBy")

  leadsCreated Lead[] @relation("LeadCreatedBy")
  leadsUpdated Lead[] @relation("LeadUpdatedBy")

  mbbsLeadsCreated MbbsLead[] @relation("MbbsLeadCreatedBy")
  mbbsLeadsUpdated MbbsLead[] @relation("MbbsLeadUpdatedBy")

  fintechAssignedStudentLoans StudentLoanProfile[] @relation("FintechAssignedStudentLoans")

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  intakeTargets        CounsellorIntakeTarget[] @relation("UserIntakeTargets")
  createdIntakeTargets CounsellorIntakeTarget[] @relation("UserCreatedIntakeTargets")

  loanApplicationsCounseled LoanApplication[] @relation("LoanApplicationCounselor")
  loanApplicationsFintech   LoanApplication[] @relation("LoanApplicationFintech")

  loanActivitiesCreated  LoanActivity[]    @relation("LoanActivityCreatedBy")
  loanApplicationCreated LoanApplication[] @relation("LoanApplicationCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id String @id @default(uuid())

  name String @unique

  description String?

  isSystem Boolean @default(false)

  users User[]

  modulePermissions RoleModulePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id String @id @default(uuid())

  name String

  code String @unique

  icon String?

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  modulePermissions RoleModulePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoleModulePermission {
  roleId String

  moduleId String

  canCreate Boolean @default(false)

  canRead Boolean @default(false)

  canUpdate Boolean @default(false)

  canDelete Boolean @default(false)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([roleId, moduleId])
}

model CounsellorIntakeTarget {
  id String @id @default(uuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  counsellorId String
  counsellor   User   @relation("UserIntakeTargets", fields: [counsellorId], references: [id], onDelete: Cascade)

  intakeId String
  intake   Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  target Int @default(0)

  createdById String?
  createdBy   User?   @relation("UserCreatedIntakeTargets", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([counsellorId, intakeId, branchId])
  @@index([intakeId])
  @@index([branchId])
  @@index([createdById])
}

enum LeadStatus {
  draft
  new
  contacted
  qualified
  converted
  lost
}

enum MbbsLeadStatus {
  new
  contacted
  qualified
  admitted
  enrolled
  lost
}

enum StudentStatus {
  active
  inactive
  drop
}

enum LeadType {
  study_abroad
  mbbs
}

enum GraduationStatus {
  completed
  pursuing
}

enum EnglishTestType {
  IELTS
  TOEFL
  DUOLINGO
  PTE
}

model LeadEnglishTest {
  id String @id @default(uuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  testType EnglishTestType

  totalScore     Float?
  listeningScore Float?
  readingScore   Float?
  writingScore   Float?
  speakingScore  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadId, testType])
  @@index([leadId])
  @@index([testType])
}

model Lead {
  id String @id @default(uuid())

  leadNumber      String    @unique
  leadType        LeadType  @default(study_abroad)
  counsellingDate DateTime?

  studentName String?
  fatherName  String?

  mobileNumber String? @unique
  emailId      String? @unique

  place    String?
  passport String?

  passportExpireDate DateTime?

  source String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  counselors LeadCounselor[]

  isConverted   Boolean @default(false)
  convertedById String?

  convertedBy User? @relation("LeadConvertedBy", fields: [convertedById], references: [id], onDelete: SetNull)

  convertedAt DateTime?

  tenthPercentage    Float?
  tenthYearOfPassing Int?

  twelfthPercentage    Float?
  twelfthYearOfPassing Int?

  bachelorsCourse         String?
  bachelorsUniversityName String?

  bachelorsPercentage    Float?
  bachelorsYearOfPassing Int?

  backlogs Int?

  workExperience String?

  preferredCountry String?
  preferredIntake  String?
  preferredCourse  String?
  preferredTiers   String[] @default([])

  greGmatScore           Float?
  quantitativeScore      Float?
  verbalScore            Float?
  analyticalWritingScore Float?

  englishTests LeadEnglishTest[]

  gapsIfAny String?

  status           LeadStatus        @default(new)
  graduationStatus GraduationStatus?
  loanRequirement  Boolean           @default(false)
  nextFollowup     DateTime?
  remarks          String?

  student   Student?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  updatedById String?

  createdBy User? @relation("LeadCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("LeadUpdatedBy", fields: [updatedById], references: [id])

  timelines LeadTimeline[]

  loanApplication LoanApplication?

  @@index([branchId])
  @@index([branchId, status])
  @@index([branchId, isConverted])
  @@index([convertedById])
}

model LeadCounselor {
  id String @id @default(uuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  counselorId String
  counselor   User   @relation(fields: [counselorId], references: [id])

  assignedAt DateTime @default(now())

  assignedById String?
  assignedBy   User?   @relation("LeadAssignedBy", fields: [assignedById], references: [id])

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([leadId, counselorId])
}

model MbbsLeadCounselor {
  id String @id @default(uuid())

  mbbsLeadId String
  mbbsLead   MbbsLead @relation(fields: [mbbsLeadId], references: [id], onDelete: Cascade)

  counselorId String
  counselor   User   @relation(fields: [counselorId], references: [id])

  assignedAt DateTime @default(now())

  assignedById String?
  assignedBy   User?   @relation("MbbsLeadAssignedBy", fields: [assignedById], references: [id])

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([mbbsLeadId, counselorId])
}

model LeadTimeline {
  id String @id @default(uuid())

  leadId String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  description  String
  nextFollowup DateTime?

  createdById String?
  updatedById String?

  createdBy User? @relation("LeadTimelineCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("LeadTimelineUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
}

model MbbsLeadTimeline {
  id String @id @default(uuid())

  mbbsLeadId String

  mbbsLead MbbsLead @relation(fields: [mbbsLeadId], references: [id])

  description  String
  nextFollowup DateTime?

  createdById String?
  updatedById String?

  createdBy User? @relation("MbbsTimelineCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("MbbsTimelineUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mbbsLeadId])
}

model MbbsLead {
  id String @id @default(uuid())

  leadNumber String @unique

  counsellingDate DateTime?

  studentName String?
  fatherName  String?

  mobileNumber String? @unique
  emailId      String? @unique

  address String?

  state String?
  city  String?

  passport           String?
  passportExpireDate DateTime?

  source String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  twelfthCollegeName String?
  twelfthMarks       Float?

  neetMarks Float?

  timelines MbbsLeadTimeline[]

  ept String?

  listeningScore Float?
  readingScore   Float?
  writingScore   Float?
  speakingScore  Float?

  preferredCountry    String?
  preferredIntake     String?
  preferredUniversity String?
  preferredCourse     String?
  preferredTiers      String[] @default([])

  remarks String?

  counselors MbbsLeadCounselor[]

  status MbbsLeadStatus @default(new)

  nextFollowup DateTime?

  createdById String?
  updatedById String?

  createdBy User? @relation("MbbsLeadCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("MbbsLeadUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StudentStage {
  application_started

  application_submitted

  offer_received

  deposit_pending
  deposit_paid

  cas_pending
  cas_received

  visa_filing

  visa_approved
  visa_rejected

  enrolled
}

enum GenderType {
  male
  female
  others
}

enum Undergraduate {
  pursuing
  graduate
}

model Student {
  id String @id @default(uuid())

  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  counselorId String?
  counselor   User?   @relation("CounselorStudents", fields: [counselorId], references: [id])

  studentName String

  mobileNumber String  @unique
  emailId      String  @unique
  password     String?

  undergraduate Undergraduate?

  moi String?

  dob DateTime?

  gender GenderType?

  applicationDate DateTime?

  currentStage StudentStage?
  status       StudentStatus @default(active)

  applications StudentApplication[]

  visaProfile StudentVisaProfile?

  loanProfile StudentLoanProfile?

  remarks StudentRemark[]

  timeline StudentTimeline[]

  documents StudentDocument[]

  moduleProgress StudentModuleProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([counselorId])
}

enum ApplicationStatus {
  on_hold

  applied

  drop
}

enum OfferStatus {
  PENDING

  PRIORITY_UCOL

  PRIORITY_COL

  COL

  UCOL
}

model StudentApplication {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Master References
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id])

  universityId String
  university   University @relation(fields: [universityId], references: [id])

  courseId String
  course   UniversityCourse @relation(fields: [courseId], references: [id])

  intakeId String?
  intake   Intake? @relation(fields: [intakeId], references: [id])

  // CRM Fields
  portal String?

  applicationDate DateTime?

  followUpDate DateTime?

  status ApplicationStatus @default(on_hold)

  offerStatus OfferStatus @default(PENDING)

  // Snapshot Values
  countryName    String?
  universityName String?
  courseName     String?
  intakeName     String?

  remarks String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([countryId])
  @@index([universityId])
  @@index([courseId])
  @@index([intakeId])
}

enum IhsPaidStatus {
  PAID

  PENDING

  PAID_PARTIALLY
}

enum VisaStatus {
  APPROVED

  REJECTED

  DECISION_PENDING
}

enum CasStatus {
  APPLIED

  RECEIVED

  PENDING
}

enum DepositStatus {
  PAID

  PENDING
}

enum InterviewStatus {
  PASSED

  FAILED

  NO_INTERVIEW
}

model StudentVisaProfile {
  id String @id @default(uuid())

  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  depositDeadlineDate DateTime?
  depositStatus       DepositStatus @default(PENDING)

  ihsPaidStatus  IhsPaidStatus @default(PENDING)
  visaPaidStatus String?

  casDeadlineDate DateTime?
  casStatus       CasStatus @default(PENDING)

  visaStatus          VisaStatus      @default(DECISION_PENDING)
  visaDecisionDate    DateTime?
  universityStartDate DateTime?
  universityEndDate   DateTime?
  interviewStatus     InterviewStatus @default(NO_INTERVIEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([depositStatus])
  @@index([casStatus])
  @@index([visaStatus])
  @@index([visaDecisionDate])
}

model StudentLoanProfile {
  id String @id @default(uuid())

  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  fintechAssigneeId String?
  fintechAssignee   User?   @relation("FintechAssignedStudentLoans", fields: [fintechAssigneeId], references: [id])

  nbfc String?

  loanStatus String?
  pfStatus   String?

  depositDate DateTime?

  disbursed     Boolean   @default(false)
  disbursedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loanStatus])
  @@index([fintechAssigneeId])
}

model StudentRemark {
  id String @id @default(uuid())

  studentId String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  note String @db.Text

  createdById String?
  createdBy   User?   @relation("StudentRemark", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([studentId])
}

model StudentDocument {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  documentCode String
  documentType String

  originalFileName String
  storedFileName   String
  fileUrl          String
  mimeType         String
  fileSize         Int

  remarks String? @db.Text

  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([studentId])
  @@index([studentId, documentCode])
}

enum StudentModuleType {
  basic_information
  documents
  university_applications
  visa_process
  loan_process
}

enum StudentModuleStatus {
  not_started
  started
  in_progress
  need_corrections
  completed
  rejected
}

model StudentModuleProgress {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  module   StudentModuleType
  status   StudentModuleStatus @default(not_started)
  progress Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, module])
  @@index([studentId])
  @@index([status])
}

model Branch {
  id String @id @default(uuid())

  name String @unique
  code String @unique

  email String?
  phone String?

  city  String?
  state String?

  country String?
  pincode String?

  address String?

  status Boolean @default(true)

  users     User[]
  leads     Lead[]
  mbbsLeads MbbsLead[]
  students  Student[]

  loanApplications        LoanApplication[]
  counsellorIntakeTargets CounsellorIntakeTarget[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

enum TimelineType {
  note
  followup
  call
  meeting

  status_change

  document
  application
  offer_letter

  loan
  visa

  payment

  info
}

model StudentTimeline {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  type TimelineType

  description String? @db.Text

  followupDate DateTime?

  createdById String?

  createdBy User? @relation("StudentTimelineCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([studentId, createdAt])
}

model Country {
  id String @id @default(uuid())

  name String @unique

  code String @unique // AU, US, UK, CA

  currency String?

  universities        University[]
  studentApplications StudentApplication[]

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Intake {
  id String @id @default(uuid())

  name String @unique

  status Boolean @default(true)

  courses             UniversityCourse[]
  studentApplications StudentApplication[]

  counsellorTargets CounsellorIntakeTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeadSource {
  id String @id @default(uuid())

  name String @unique

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeadDegree {
  id String @id @default(uuid())

  name String @unique

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeadUniversity {
  id String @id @default(uuid())

  name String @unique

  status Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bank {
  id String @id @default(uuid())

  name String @unique

  status Boolean @default(true)

  loanApplications LoanBankApplication[]

  sanctions LoanSanction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([name])
}

enum UniversityTier {
  T1
  T2
  T3
  T4
}

model University {
  id String @id @default(uuid())

  name String

  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  tier UniversityTier @default(T4)

  logo String?

  website String?

  address    String?
  city       String?
  state      String?
  postalCode String?

  ranking Int?

  establishedYear Int?

  applicationFee Decimal? @db.Decimal(12, 2)

  currency String? // USD, AUD, GBP, CAD

  description String? @db.Text

  status UniversityStatus @default(active)

  courses      UniversityCourse[]
  scholarships UniversityScholarship[]

  studentApplications StudentApplication[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  intakeNotes   String?  @db.Text

  @@unique([name, countryId])
  @@index([countryId])
  @@index([countryId, city])
  @@index([name])
  @@index([city])
  @@index([status])
}

enum DegreeType {
  diploma
  bachelors
  masters
  phd
  mba
  certificate
}

model UniversityCourse {
  id String @id @default(uuid())

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  name String

  degree DegreeType?

  durationMonths Int?

  annualTuitionFee Decimal? @db.Decimal(12, 2)

  totalTuitionFee Decimal? @db.Decimal(12, 2)

  currency String?

  intakeId String?
  intake   Intake? @relation(fields: [intakeId], references: [id])

  minimumPercentage Float?

  backlogLimit Int?

  englishRequirement String?

  ieltsOverall   Float?
  ieltsListening Float?
  ieltsReading   Float?
  ieltsWriting   Float?
  ieltsSpeaking  Float?

  greRequired         Boolean   @default(false)
  gmatRequired        Boolean   @default(false)
  courseCode          String?
  description         String?   @db.Text
  applicationDeadline DateTime?
  status              Boolean   @default(true)

  scholarships UniversityScholarship[]

  studentApplications StudentApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId])
}

enum UniversityStatus {
  active
  inactive
  archived
}

model UniversityScholarship {
  id String @id @default(uuid())

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  name String

  amount Decimal? @db.Decimal(12, 2)

  percentage Float?

  description String? @db.Text

  status    UniversityStatus  @default(active)
  courseId  String?
  course    UniversityCourse? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([universityId])
  @@index([courseId])
}

// loan-application
model LoanApplication {
  id String @id @default(uuid())

  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  applicationId            String    @unique
  fullName                 String
  mobile                   String
  altMobile                String?
  email                    String
  dob                      DateTime?
  gender                   String?
  maritalStatus            String?
  aadhaar                  String?
  pan                      String?
  passport                 String?
  passportExpireDate       DateTime?
  currentAddress           String?   @db.Text
  permanentAddress         String?   @db.Text
  city                     String?
  state                    String?
  pin                      String?
  enquiryDate              DateTime?
  leadSource               String?
  branchId                 String
  branch                   Branch    @relation(fields: [branchId], references: [id])
  counselorId              String?
  counselor                User?     @relation("LoanApplicationCounselor", fields: [counselorId], references: [id], onDelete: SetNull)
  fintechAssigneeId        String?
  fintechAssignee          User?     @relation("LoanApplicationFintech", fields: [fintechAssigneeId], references: [id], onDelete: SetNull)
  priority                 String?
  nextFollowUp             DateTime?
  remarks                  String?   @db.Text
  applicantCategory        String
  loanCategory             String
  loanStatus               String    @default("New Enquiry")
  qualification            String?
  graduationStatus         String?
  percentage               String?
  yearOfPassing            String?
  currentInstitution       String?
  workExperience           String?
  company                  String?
  designation              String?
  employmentType           String?
  employeeId               String?
  totalExperience          String?
  currentCompanyExperience String?
  monthlySalary            Decimal?  @db.Decimal(12, 2)
  annualIncome             Decimal?  @db.Decimal(12, 2)
  existingEmi              Decimal?  @db.Decimal(12, 2)
  employerAddress          String?   @db.Text
  businessName             String?
  businessType             String?
  registrationType         String?
  registrationNumber       String?
  yearsInBusiness          String?
  annualTurnover           Decimal?  @db.Decimal(12, 2)
  businessAddress          String?   @db.Text
  studyDestination         String?
  country                  String?
  university               String?
  courseName               String?
  courseLevel              String?
  courseDuration           String?
  intake                   String?
  admissionStatus          String?
  offerLetterReceived      String?
  tuitionFee               Decimal?  @db.Decimal(12, 2)
  livingExpenses           Decimal?  @db.Decimal(12, 2)
  otherExpenses            Decimal?  @db.Decimal(12, 2)
  totalCourseCost          Decimal?  @db.Decimal(12, 2)
  ownContribution          Decimal?  @db.Decimal(12, 2)
  requiredLoanAmount       Decimal?  @db.Decimal(12, 2)
  loanPreference           String?
  collateralAvailable      String?
  loanPurpose              String?
  preferredTenure          Int?
  cibilScore               Int?
  propertyType             String?
  propertyLocation         String?
  propertyValue            Decimal?  @db.Decimal(12, 2)
  downPayment              Decimal?  @db.Decimal(12, 2)
  sanctionedAmount         Decimal?  @db.Decimal(12, 2)
  disbursedAmount          Decimal?  @db.Decimal(12, 2)
  depositAmount            Decimal?  @db.Decimal(12, 2)
  depositDate              DateTime?
  depositReference         String?
  depositBank              String?

  depositStatus String? @default("Pending")

  depositRemarks   String?               @db.Text
  bankApplications LoanBankApplication[]
  coApplicants     LoanCoApplicant[]
  followUps        LoanFollowUp[]
  activities       LoanActivity[]
  documents        LoanDocument[]

  sanction LoanSanction?

  disbursement LoanDisbursement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?

  createdBy User? @relation("LoanApplicationCreatedBy", fields: [createdById], references: [id])

  @@index([branchId])
  @@index([counselorId])
  @@index([fintechAssigneeId])
  @@index([loanStatus])
  @@index([loanCategory])
}

model LoanBankApplication {
  id String @id @default(uuid())

  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  bankId String
  bank   Bank   @relation(fields: [bankId], references: [id])

  branch String?

  applicationNo String?

  applicationDate DateTime?

  appliedAmount Decimal? @db.Decimal(12, 2)

  loanType String?

  roi Decimal? @db.Decimal(5, 2)

  tenure Int?

  processingFee Decimal? @db.Decimal(12, 2)

  insuranceAmount Decimal? @db.Decimal(12, 2)

  moratorium String?

  loginExecutive String?

  status String?

  rejectionReason String?

  remarks String? @db.Text

  sanction LoanSanction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([bankId])
  @@index([status])
}

model LoanSanction {
  id String @id @default(uuid())

  applicationId String          @unique
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  bankApplicationId String?              @unique
  bankApplication   LoanBankApplication? @relation(fields: [bankApplicationId], references: [id])

  bankId String
  bank   Bank   @relation(fields: [bankId], references: [id])

  sanctionNo String?

  sanctionDate DateTime?

  sanctionedAmount Decimal? @db.Decimal(12, 2)

  roi Decimal? @db.Decimal(5, 2)

  tenure Int?

  emi Decimal? @db.Decimal(12, 2)

  moratorium String?

  processingFee Decimal? @db.Decimal(12, 2)

  insuranceAmount Decimal? @db.Decimal(12, 2)

  sanctionLetter String?

  expiryDate DateTime?

  remarks String? @db.Text

  disbursement LoanDisbursement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bankId])
}

model LoanDisbursement {
  id String @id @default(uuid())

  applicationId String          @unique
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  sanctionId String       @unique
  sanction   LoanSanction @relation(fields: [sanctionId], references: [id], onDelete: Cascade)

  disbursementDate DateTime?

  disbursedAmount Decimal? @db.Decimal(12, 2)

  disbursementReference String?

  disbursementStatus String @default("Yes")

  accountNumber String?

  transactionId String?

  beneficiary String?

  paymentMode String?

  remarks String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanCoApplicant {
  id String @id @default(uuid())

  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Personal Information
  name         String
  relationship String?
  dob          DateTime?
  gender       String?

  // Contact Information
  mobile    String?
  altMobile String?
  email     String?

  // Identity Information
  pan     String?
  aadhaar String?

  // Address Information
  address String?
  city    String?
  state   String?
  pin     String?

  // Employment Information
  employmentType String?
  occupation     String?
  employerName   String?
  designation    String?

  // Financial Information
  monthlyIncome Decimal? @db.Decimal(15, 2)
  annualIncome  Decimal? @db.Decimal(15, 2)
  existingEmi   Decimal? @db.Decimal(15, 2)

  // Keep old income field if existing production data uses it
  income Decimal? @db.Decimal(15, 2)

  // Credit Information
  cibilScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
}

model LoanFollowUp {
  id            String          @id @default(uuid())
  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String?
  note          String          @db.Text
  followUpDate  DateTime?
  nextFollowUp  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([applicationId])
  @@index([nextFollowUp])
}

model LoanActivity {
  id            String   @id @default(uuid())
  applicationId String
  type          String?
  title         String
  description   String?
  createdById   String?
  createdAt     DateTime @default(now())

  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdBy User? @relation("LoanActivityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([createdById])
}

model LoanDocument {
  id               String          @id @default(uuid())
  applicationId    String
  application      LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentCode     String
  documentType     String
  originalFileName String
  storedFileName   String
  fileUrl          String
  mimeType         String
  fileSize         Int
  remarks          String?         @db.Text
  uploadedAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([applicationId])
  @@index([applicationId, documentCode])
}
